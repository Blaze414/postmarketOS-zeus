pkgver=1
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-xiaomi-zeus-adsp
	firmware-xiaomi-zeus-cdsp
	firmware-xiaomi-zeus-gpu
	firmware-xiaomi-zeus-initramfs
	firmware-xiaomi-zeus-ipa
