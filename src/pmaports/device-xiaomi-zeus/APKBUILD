# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-xiaomi-zeus
pkgdesc="Xiaomi 12 Pro"
pkgver=1
pkgrel=15
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-xiaomi-zeus-adsp
	firmware-xiaomi-zeus-cdsp
	firmware-xiaomi-zeus-gpu
	firmware-xiaomi-zeus-initramfs
	firmware-xiaomi-zeus-ipa
	firmware-xiaomi-zeus-modem
	firmware-xiaomi-zeus-slpi
	firmware-xiaomi-zeus-touchscreen
	linux-firmware-ath11k
	linux-firmware-qca
	linux-firmware-qcom
	linux-postmarketos-qcom-sm8450-zeus
	make-dynpart-mappings
	mkbootimg
	msm-modem
	msm-modem-uim-selection
	postmarketos-base
	qbootctl
	tqftpserv
"
# NB: cupid defines an openrc() function but never lists it in subpackages, so
# abuild silently never builds it. On an A/B device that matters: the openrc
# subpackage pulls in qbootctl-openrc, which marks the slot as successfully
# booted. Without it the bootloader eventually gives up on the slot and rolls
# back. Declared explicitly here.
subpackages="
	$pkgname-phosh
	$pkgname-openrc
	"
makedepends="
	devicepkg-dev
"
source="
	deviceinfo
	phoc.ini
	xiaomi,zeus.json
	zeus-phosh-session
	zeus-cpufreq.start
	zeus-cpu-profile
	Xiaomi-12.conf
	HiFi.conf
	sm.puri.OSK0.desktop
	zeus-environment.start
	zeus-modules.conf
"

build() {
	devicepkg_build $startdir $pkgname
}
package() {
	devicepkg_package $startdir $pkgname

	install -D -m755 "$srcdir"/zeus-cpufreq.start \
		"$pkgdir"/etc/local.d/zeus-cpufreq.start
	install -D -m755 "$srcdir"/zeus-cpu-profile \
		"$pkgdir"/usr/bin/zeus-cpu-profile

	# ALSA use case manager profile. Without one matching this card the sound
	# server cannot configure it and falls back to a Dummy Output; with it the
	# codec routing is set up and a real sink appears.
	install -D -m644 "$srcdir"/Xiaomi-12.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8450/Xiaomi-12.conf
	install -D -m644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8450/Zeus/HiFi.conf

	# Everything below used to be done by the -openrc post-install. On this
	# pmbootstrap/apk combination that script is recorded in the rootfs but
	# never executed, which silently cost touch, the OSK, the notch and the
	# qbootctl runlevel. Plain files and symlinks are always installed.

	# ADSP topology: the card requests qcom/sm8450/Xiaomi-12-tplg.bin and will
	# not probe without it. The SM8450 HDK's is the only one this firmware
	# accepts; a zeus-specific one with a tertiary I2S backend is rejected at
	# APM_CMD_GRAPH_OPEN and takes the headphone path down too (doc 11).
	mkdir -p "$pkgdir"/lib/firmware/qcom/sm8450
	ln -s SM8450-HDK-tplg.bin.zst \
		"$pkgdir"/lib/firmware/qcom/sm8450/Xiaomi-12-tplg.bin.zst

	install -D -m644 "$srcdir"/zeus-modules.conf \
		"$pkgdir"/etc/modules-load.d/zeus.conf
	install -D -m755 "$srcdir"/zeus-environment.start \
		"$pkgdir"/etc/local.d/zeus-environment.start
	install -D -m644 "$srcdir"/sm.puri.OSK0.desktop \
		"$pkgdir"/etc/xdg/autostart/sm.puri.OSK0.desktop

	# Without qbootctl in a runlevel the slot is never marked successful and
	# ABL drops to fastboot after about seven boots.
	mkdir -p "$pkgdir"/etc/runlevels/default
	ln -s /etc/init.d/qbootctl "$pkgdir"/etc/runlevels/default/qbootctl
}

phosh() {
	install_if="$pkgname postmarketos-ui-phosh"

	install -D -m644 "$srcdir"/phoc.ini \
		"$subpkgdir"/etc/phosh/phoc.ini

	# Display cutout. gmobile only reads panel definitions from its
	# compiled-in GResource and upstream has no entry for zeus, so phosh
	# never learns this panel has a punch-hole. The session wrapper points
	# G_RESOURCE_OVERLAYS at the file below, which is enough - no rebuild of
	# gmobile required.
	install -D -m644 "$srcdir"/xiaomi,zeus.json \
		"$subpkgdir"/usr/share/gmobile/devices/display-panels/xiaomi,zeus.json
	# /usr/bin, not /usr/local/bin: abuild 3.15 refuses to package anything
	# under /usr/local ("Packages must not put anything under /usr/local").
	install -D -m755 "$srcdir"/zeus-phosh-session \
		"$subpkgdir"/usr/bin/zeus-phosh-session
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	# The qbootctl runlevel link is shipped by the main package: the
	# post-install that used to create it is never executed on this image.
	depends="tqftpserv-openrc"

	mkdir -p "$subpkgdir"
}
