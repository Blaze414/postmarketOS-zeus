	linux-firmware-qcom
	linux-postmarketos-qcom-sm8450-zeus
	make-dynpart-mappings
	mkbootimg
	msm-modem
	msm-modem-uim-selection
	postmarketos-base
	qbootctl
	tqftpserv
"
makedepends="
	devicepkg-dev
"
source="
	deviceinfo
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="qbootctl-openrc tqftpserv-openrc"

	mkdir -p "$subpkgdir"
}
