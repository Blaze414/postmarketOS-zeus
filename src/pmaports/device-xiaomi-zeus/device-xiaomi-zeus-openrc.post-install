#!/bin/sh
# Nothing else puts qbootctl in a runlevel. On this device the init script ships
# with the main qbootctl package rather than a qbootctl-openrc subpackage, so
# depending on that subpackage is not enough - it is not even available here.
#
# Without it the slot is never marked successful, ABL decrements its retry
# counter on every single boot, and after about seven boots the device declares
# the slot unbootable and drops to fastboot on its own. That looks exactly like
# a crash and is not one.
rc-update add qbootctl default 2>/dev/null || true

# zeus now ships its own ADSP topology (see the package's build()), so drop the
# symlink that earlier versions pointed at the SM8450 HDK's. Leaving it behind
# is not harmful - the firmware loader prefers the uncompressed name that is now
# a real file - but it makes it look like the HDK topology is still in use.
rm -f /lib/firmware/qcom/sm8450/Xiaomi-12-tplg.bin.zst

# On-screen keyboard.
#
# stevia ships /usr/share/applications/sm.puri.OSK0.desktop with
# "OnlyShowIn=Phosh", but this session runs gnome-session and reports
# XDG_CURRENT_DESKTOP=GNOME, so autostart skipped it and the keyboard never
# appeared when a text field was focused. Copy it into the autostart directory
# with that restriction dropped.
OSK=/usr/share/applications/sm.puri.OSK0.desktop
if [ -e "$OSK" ]; then
	mkdir -p /etc/xdg/autostart
	sed -e '/^OnlyShowIn=/d' -e '/^X-GNOME-HiddenUnderSystemd=/d' \
		"$OSK" > /etc/xdg/autostart/sm.puri.OSK0.desktop
fi

# Display cutout: run the session through the wrapper that sets
# G_RESOURCE_OVERLAYS, so gmobile can see this panel's definition.
GC=/etc/phrog/greetd-config.toml
if [ -e "$GC" ] && grep -q '^command = "/usr/bin/phosh-session"' "$GC"; then
	sed -i 's|^command = "/usr/bin/phosh-session"|command = "/usr/local/bin/zeus-phosh-session"|' "$GC"
fi

# The compositor gets respawned without the session wrapper's environment, so
# the cutout overlay is set globally as well - otherwise phosh silently loses
# the panel definition mid-session.
if ! grep -q G_RESOURCE_OVERLAYS /etc/environment 2>/dev/null; then
	printf '%s\n' \
	  'G_RESOURCE_OVERLAYS=/mobi/phosh/gmobile/devices/display-panels/xiaomi,zeus.json=/usr/share/gmobile/devices/display-panels/xiaomi,zeus.json' \
	  >> /etc/environment
fi
rc-update add local default 2>/dev/null || true
