#!/bin/sh
# gmobile only reads display-panel definitions from its compiled-in GResource
# and upstream has no entry for zeus, so phosh cannot see that this panel has a
# punch-hole. G_RESOURCE_OVERLAYS redirects that one resource at a file on disk.
#
# It is also set in /etc/environment, because the compositor gets respawned
# without this wrapper's environment and would otherwise lose the overlay. Kept
# here too so the session works even if /etc/environment is not applied.
OV=/usr/share/gmobile/devices/display-panels
export G_RESOURCE_OVERLAYS="/mobi/phosh/gmobile/devices/display-panels/xiaomi,zeus.json=$OV/xiaomi,zeus.json"

exec /usr/bin/phosh-session "$@"
