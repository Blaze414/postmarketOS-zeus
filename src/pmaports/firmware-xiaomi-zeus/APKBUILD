# Proprietary firmware for the Xiaomi 12 Pro (zeus).
#
# Unlike firmware-xiaomi-cupid, this does not fetch a tarball from
# git.mainlining.org: there is no firmware-xiaomi-zeus repository upstream (the
# GitHub one is empty, and git.mainlining.org returns 502). The blobs were
# extracted from the device itself with scripts/dump-firmware.sh, and the split
# .mdt/.bNN files merged into .mbn with scripts/pil-squash.py.
#
# The tarball is built locally and is NOT committed - it is Xiaomi's proprietary
# firmware, ~77MB. Regenerate it on a rooted zeus with:
#   ./scripts/dump-firmware.sh && ./scripts/pack-firmware.sh
pkgname=firmware-xiaomi-zeus
pkgver=1
pkgrel=0
pkgdesc="Firmware for Xiaomi 12 Pro"
subpackages="
	$pkgname-adsp
	$pkgname-cdsp
	$pkgname-gpu
	$pkgname-initramfs
	$pkgname-ipa
	$pkgname-modem
	$pkgname-slpi
	"
url="https://github.com/sm8450-mainline"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
source="
	$pkgname-$pkgver.tar.gz
	30-initramfs-firmware.files
"
builddir="$srcdir/$pkgname"

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

adsp() {
	pkgdesc="Xiaomi 12 Pro adsp firmware"

	install -Dm644 "$builddir"/adsp* -t \
		"$subpkgdir/lib/firmware/qcom/sm8450/zeus"
}

cdsp() {
	pkgdesc="Xiaomi 12 Pro cdsp firmware"

	install -Dm644 "$builddir"/cdsp* -t \
		"$subpkgdir/lib/firmware/qcom/sm8450/zeus"
}

gpu() {
	pkgdesc="Xiaomi 12 Pro gpu firmware"

	install -Dm644 "$builddir"/a730* -t \
		"$subpkgdir/lib/firmware/qcom/"
	install -Dm644 "$builddir"/gmu_gen7* -t \
		"$subpkgdir/lib/firmware/qcom/"
}

initramfs() {
	pkgdesc="Xiaomi 12 Pro firmware to be included in the initramfs"

	install -Dm644 "$srcdir/30-initramfs-firmware.files" -t \
		"$subpkgdir"/usr/share/mkinitfs/files
}

ipa() {
	pkgdesc="Xiaomi 12 Pro ipa firmware"

	install -Dm644 "$builddir"/ipa_fws.* -t \
		"$subpkgdir/lib/firmware/qcom/sm8450/zeus"
}

modem() {
	pkgdesc="Xiaomi 12 Pro modem firmware"

	# cp because of the modem_pr directory
	mkdir -p "$subpkgdir/lib/firmware/qcom/sm8450/zeus"
	cp -r "$builddir"/modem* \
		"$subpkgdir/lib/firmware/qcom/sm8450/zeus"
	find "$subpkgdir/lib/firmware/qcom/sm8450/zeus" \
		-type f -exec chmod 0644 {} \;
}

slpi() {
	pkgdesc="Xiaomi 12 Pro slpi firmware"

	install -Dm644 "$builddir"/slpi* -t \
		"$subpkgdir/lib/firmware/qcom/sm8450/zeus"
}
sha512sums="
