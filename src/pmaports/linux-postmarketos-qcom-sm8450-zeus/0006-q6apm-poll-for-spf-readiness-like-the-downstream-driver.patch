diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 2a2a5bd98..1c32c24bd 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -146,17 +146,42 @@ static void q6apm_put_audioreach_graph(struct kref *ref)
 }
 
 
+/*
+ * The signal processing framework is not up as soon as the ADSP is, and asking
+ * once loses the race: the command simply goes unanswered, the state stays 0,
+ * and every graph operation afterwards fails - which presents as a sound card
+ * that registers and then returns -EIO on any playback.
+ *
+ * Qualcomm's own driver polls rather than asking once. spf_core_is_apm_ready()
+ * in the downstream audio-kernel re-sends APM_CMD_GET_SPF_STATE in a loop,
+ * sleeping 50ms between attempts, for up to APM_STATE_READY_TIMEOUT_MS. Do the
+ * same here; a ready ADSP still answers on the first attempt, so this costs
+ * nothing when the race is won.
+ */
+#define APM_STATE_READY_TIMEOUT_MS	10000
+#define APM_STATE_POLL_INTERVAL_US	50000
+
 static int q6apm_get_apm_state(struct q6apm *apm)
 {
+	unsigned long timeout;
 	struct gpr_pkt *pkt;
 
-	pkt = audioreach_alloc_apm_cmd_pkt(0, APM_CMD_GET_SPF_STATE, 0);
-	if (IS_ERR(pkt))
-		return PTR_ERR(pkt);
+	timeout = jiffies + msecs_to_jiffies(APM_STATE_READY_TIMEOUT_MS);
 
-	q6apm_send_cmd_sync(apm, pkt, APM_CMD_RSP_GET_SPF_STATE);
+	do {
+		pkt = audioreach_alloc_apm_cmd_pkt(0, APM_CMD_GET_SPF_STATE, 0);
+		if (IS_ERR(pkt))
+			return PTR_ERR(pkt);
 
-	kfree(pkt);
+		q6apm_send_cmd_sync(apm, pkt, APM_CMD_RSP_GET_SPF_STATE);
+		kfree(pkt);
+
+		if (apm->state)
+			break;
+
+		usleep_range(APM_STATE_POLL_INTERVAL_US,
+			     APM_STATE_POLL_INTERVAL_US + 50);
+	} while (time_before(jiffies, timeout));
 
 	return apm->state;
 }
