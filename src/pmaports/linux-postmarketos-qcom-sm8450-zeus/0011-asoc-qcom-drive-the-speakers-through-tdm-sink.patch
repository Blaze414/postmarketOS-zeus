+/*
+ * MI2S and TDM backends are not SoundWire. Allocating a SoundWire stream for
+ * them is pointless, and on a codec DAI without ops (a stub codec) it is a
+ * NULL dereference inside snd_soc_dai_set_stream().
+ */
+static bool sc8280xp_is_sdw_backend(int id)
+{
+	switch (id) {
+	case PRIMARY_MI2S_RX ... QUATERNARY_MI2S_TX:
+	case QUINARY_MI2S_RX ... QUINARY_MI2S_TX:
+	case PRIMARY_TDM_RX_0 ... QUINARY_TDM_TX_7:
+		return false;
+	default:
+		return true;
+	}
+}
+
+static int sc8280xp_snd_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+
+	if (!sc8280xp_is_sdw_backend(snd_soc_rtd_to_cpu(rtd, 0)->id))
+		return 0;
+
+	return qcom_snd_sdw_startup(substream);
+}
+
