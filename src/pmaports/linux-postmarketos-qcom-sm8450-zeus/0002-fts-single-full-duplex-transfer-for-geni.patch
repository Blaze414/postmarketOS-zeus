+#ifndef I2C_INTERFACE
+/**
+* Perform a write-then-read as a SINGLE full duplex transfer.
+*
+* This driver natively splits a register read into a TX-only transfer carrying
+* the address followed by an RX-only transfer collecting the data. A bitbanged
+* bus holds the chip select low across both and the FingerTip answers normally,
+* which is how we know the chip is healthy. Qualcomm's GENI controller does not
+* reproduce that: every read split this way comes back as exactly 0x00, never
+* garbage and never partial, and with the GPI DMA channels removed the transfer
+* is rejected outright instead.
+*
+* Flattening the phases into one transfer removes the question entirely - the
+* command bytes are padded with zeros out to the full length, and the reply is
+* taken from the tail of the rx buffer, which is what full duplex gives us for
+* free. One transfer per message also means no inter-transfer behaviour for a
+* controller to get wrong.
+*
+* @param cmd1 first command block, may be NULL
+* @param cmd1Len size of cmd1
+* @param cmd2 second command block, may be NULL
+* @param cmd2Len size of cmd2
+* @param outBuf where the reply is copied, may be NULL when byteToRead is 0
+* @param byteToRead number of bytes to read after the command blocks
+* @return OK, or a negative errno straight from spi_sync
+*/
+static int fts_spi_wr(const u8 *cmd1, int cmd1Len, const u8 *cmd2, int cmd2Len,
+		      u8 *outBuf, int byteToRead)
+{
+	struct spi_message msg;
+	struct spi_transfer transfer = { 0 };
+	int head = cmd1Len + cmd2Len;
+	int total = head + byteToRead;
+	int ret = -1, retry = 0;
+	u8 *tx, *rx;
+
+	if (total <= 0)
+		return ERROR_OP_NOT_ALLOW;
+
+	/*
+	 * ponytail: one allocation pair per transfer. The touch path runs in a
+	 * threaded irq so GFP_KERNEL is fine; swap for a preallocated scratch
+	 * buffer under the bus lock if this ever shows up in a profile.
+	 */
+	tx = kzalloc(total, GFP_KERNEL);
+	rx = kzalloc(total, GFP_KERNEL);
+	if (!tx || !rx) {
+		kfree(tx);
+		kfree(rx);
+		return ERROR_ALLOC;
+	}
+
+	if (cmd1Len)
+		memcpy(tx, cmd1, cmd1Len);
+	if (cmd2Len)
+		memcpy(tx + cmd1Len, cmd2, cmd2Len);
+
+	spi_message_init(&msg);
+	transfer.len = total;
+	transfer.tx_buf = tx;
+	transfer.rx_buf = rx;
+	transfer.delay.value = SPI_DELAY_CS;
+	transfer.delay.unit = SPI_DELAY_UNIT_USECS;
+	spi_message_add_tail(&transfer, &msg);
+
+	while (retry < I2C_RETRY && ret < OK) {
+		ret = spi_sync(getClient(), &msg);
+		retry++;
+		if (ret < OK)
+			mdelay(I2C_WAIT_BEFORE_RETRY);
+	}
+
+	if (ret >= 0 && byteToRead && outBuf)
+		memcpy(outBuf, rx + head, byteToRead);
+
+	kfree(tx);
+	kfree(rx);
+	return ret < 0 ? ret : OK;
+}
+#endif
