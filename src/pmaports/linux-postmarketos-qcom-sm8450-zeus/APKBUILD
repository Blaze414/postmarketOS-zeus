# Kernel for the Xiaomi 12 Pro (zeus).
#
# Why this exists instead of using linux-postmarketos-qcom-sm8450:
# that package pins commit 6a206d94 from 2023-09-07 (v6.5), which predates
# cupid's panel driver entirely - sm8450-xiaomi-cupid.dts and
# panel-l3-42-02-0a-dsc.c are not in that tree. Everything in this port was
# derived from, and tested against, the fork's next-new branch at 6.13.0-rc3.
# This package pins that exact commit so what shipped is what was built.

_flavor="postmarketos-qcom-sm8450-zeus"
pkgname=linux-$_flavor
pkgver=6.13.0_rc3
pkgrel=35
pkgdesc="Mainline kernel fork for the Xiaomi 12 Pro (zeus)"
arch="aarch64"
_carch="arm64"
url="https://github.com/sm8450-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	"
# python3: drivers/gpu/drm/msm generates its register headers at build time with
# registers/gen_header.py. Without it the build dies at
# "GENHDR drivers/gpu/drm/msm/generated/a2xx.xml.h" with error 127. The stock
# sm8450 kernel package predates that generator, which is why it does not need this.
makedepends="bison findutils flex installkernel openssl-dev perl python3"

_repo="linux"
_config="config-$_flavor.$arch"
# sm8450-mainline/linux next-new, 2025-01-11, v6.13.0-rc3
_commit="bf1d29fced6e156dd6090a9b6600a8c44259c114"

source="
	$_repo-$_commit.tar.gz::https://github.com/sm8450-mainline/$_repo/archive/$_commit/$_repo-$_commit.tar.gz
	$_config
	sm8450-xiaomi-zeus.dts
	panel-l2-38-0c-0a-dsc.c
	0001-mfd-qcom-pm8008-make-the-interrupt-optional.patch
	0002-fts-single-full-duplex-transfer-for-geni.patch
	0003-fts-palm-rejection-and-panel-follower.patch
	0004-pcie-qcom-retry-link-training-with-endpoint-reset.patch
	0005-ath11k-reset-the-firmware-when-wmi-stops-answering.patch
	0006-q6apm-poll-for-spf-readiness-like-the-downstream-driver.patch
	0007-pdr-ack-service-up-before-notifying-clients.patch
	0008-apr-install-the-gpr-callback-before-probing.patch
	0009-asoc-qcom-give-mi2s-backends-a-clock.patch
	0010-asoc-qcom-vote-the-lpass-i2s-bit-clock.patch
	0011-asoc-qcom-drive-the-speakers-through-tdm-sink.patch
"
builddir="$srcdir/$_repo-$_commit"

prepare() {
	default_prepare

	# Drop in the zeus devicetree and panel driver.
	cp "$srcdir"/sm8450-xiaomi-zeus.dts arch/arm64/boot/dts/qcom/
	cp "$srcdir"/panel-l2-38-0c-0a-dsc.c drivers/gpu/drm/panel/

	# Register the devicetree. NB: this Makefile separates with a TAB.
	local mk=arch/arm64/boot/dts/qcom/Makefile
	if ! grep -q 'sm8450-xiaomi-zeus.dtb' "$mk"; then
		sed -i 's|^\(dtb-$(CONFIG_ARCH_QCOM)[[:space:]]*+= sm8450-xiaomi-cupid.dtb\)$|\1\ndtb-$(CONFIG_ARCH_QCOM) += sm8450-xiaomi-zeus.dtb|' "$mk"
		grep -q 'sm8450-xiaomi-zeus.dtb' "$mk" || { error "dtb registration failed"; return 1; }
	fi

	# Register the panel driver.
	local pk=drivers/gpu/drm/panel/Kconfig
	if ! grep -q 'DRM_PANEL_XIAOMI_38_0C_0A' "$pk"; then
		cat >> "$pk".zeus <<-'KCONF'
		config DRM_PANEL_XIAOMI_38_0C_0A
			tristate "Xiaomi 38_0C_0A panel driver"
			depends on OF
			depends on DRM_MIPI_DSI
			depends on BACKLIGHT_CLASS_DEVICE
			select VIDEOMODE_HELPERS
			help
			  Support for the Xiaomi WQHD (3200x1440) DSC command mode panel
			  found on the Xiaomi 12 Pro.
		KCONF
		# insert before the final endmenu so the symbol lands inside the menu
		head -n -1 "$pk" > "$pk".new
		cat "$pk".zeus >> "$pk".new
		tail -n 1 "$pk" >> "$pk".new
		mv "$pk".new "$pk"
		rm -f "$pk".zeus
		grep -q 'DRM_PANEL_XIAOMI_38_0C_0A' "$pk" || { error "Kconfig registration failed"; return 1; }
	fi

	local pm=drivers/gpu/drm/panel/Makefile
	if ! grep -q 'panel-l2-38-0c-0a-dsc.o' "$pm"; then
		echo 'obj-$(CONFIG_DRM_PANEL_XIAOMI_38_0C_0A) += panel-l2-38-0c-0a-dsc.o' >> "$pm"
	fi

	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	# mkinitfs discovers kernel flavors by scanning usr/share/kernel/*/kernel.release.
	# Without this file it reports "only one kernel release/flavor is supported,
	# found: []" and the install fails at the very last step, long after the kernel
	# itself built fine.
	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}
