&i2c5 {
	clock-frequency = <100000>;
	status = "okay";

	typec-mux@42 {
		compatible = "fcs,fsa4480";
		reg = <0x42>;

		interrupts-extended = <&tlmm 2 IRQ_TYPE_LEVEL_LOW>;

		vcc-supply = <&vreg_bob>;
		mode-switch;
		orientation-switch;

		port {
			fsa4480_sbu_mux: endpoint {
				remote-endpoint = <&pmic_glink_sbu>;
			};
		};
	};

	/* nq @ 64 */

	/*
	 * zeus populates the PM8008 satellites cupid leaves commented out:
	 * pm8008i @ 0x8 (irq/reset tlmm 7) and pm8008j @ 0xc (irq/reset tlmm 11).
	 * Only pm8008j is described, because its ldo3 is the touchscreen avdd -
	 * cupid takes that from pm8350c_l7, which is wrong for this board.
	 *
	 * Downstream splits each chip over two i2c addresses (chip @ 0xc,
	 * regulators @ 0xd); the mainline binding uses one node at the chip
	 * address with the regulators as children.
	 *
	 * UNVERIFIED: ldo3's parent is set to vreg_bob, matching how other
	 * mainline boards feed a PM8008. The downstream tree does not spell the
	 * routing out. Only ldo3 is declared; nothing here consumes the others.
	 */
	pm8008j: pmic@c {
		compatible = "qcom,pm8008";
		reg = <0xc>;

		/*
		 * tlmm 11 is the chip enable, not an interrupt: downstream drives it
		 * with pinctrl (function = "gpio", output-high) and has no irq line
		 * for this PMIC. Mainline models that as reset-gpios, which the driver
		 * requests as GPIOD_OUT_LOW and then releases. Wiring it as an
		 * interrupt instead left the chip held in reset, so every register read
		 * failed with -ENXIO ("failed to read step rate: -6") and the
		 * touchscreen's avdd never appeared.
		 */
		reset-gpios = <&tlmm 11 GPIO_ACTIVE_LOW>;

		/* vdd_l3_l4 resolves to pm8350c-bob in the downstream tree. */
		vdd-l3-l4-supply = <&vreg_bob>;

		interrupt-controller;
		#interrupt-cells = <2>;

		regulators {
			vreg_l3j: ldo3 {
				regulator-name = "vreg_l3j";
				/*
				 * The pm8008 PLDO range is 1504000 + n * 8000 (n <= 237).
				 * 3300000 is not on a step, so asking for it makes the
				 * regulator core reject registration with -EINVAL.
				 * 3304000 is selector 225 exactly, and is what downstream's
				 * 3303999 rounds to.
				 */
				regulator-min-microvolt = <3304000>;
				regulator-max-microvolt = <3304000>;
				/*
				 * The FTS driver brings the touch controller up and reads its
				 * chip id immediately; with the rail only enabled on demand it
				 * read 0x0 ("read chip error,no panel"). Keep avdd on so the
				 * controller is powered before the first SPI transaction.
				 */
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};

	/* pm8008i @ 0x8 - not wired up, nothing consumes it yet */
};

&i2c9 {
	clock-frequency = <100000>;
	status = "okay";

	/* nq @ 28 */
};

&spi4 {
	clock-frequency = <50000000>;
	status = "okay";

	touchscreen@0 {
		compatible = "st,spi";
		reg = <0x0>;
		interrupt-parent = <&tlmm>;
		interrupts = <21 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		pinctrl-0 = <&mi_ts_active>;
		pinctrl-1 = <&mi_ts_suspend>;
		avdd-supply = <&vreg_l3j>;
		vdd-supply = <&pm8350c_l2>;
		fts,pwr-reg-name = "avdd";
		fts,bus-reg-name = "vdd";
		fts,irq-gpio = <&tlmm 21 IRQ_TYPE_LEVEL_LOW>;
		fts,reset-gpio-enable;
		fts,reset-gpio = <&tlmm 20 GPIO_ACTIVE_HIGH>;
		fts,irq-flags = <IRQ_TYPE_LEVEL_LOW>;
		fts,x-max = <14400>;
		fts,y-max = <32000>;
		fts,support-super-resolution = <1>;
		/*
		 * 1 MHz, not the 12 MHz downstream uses. Everything else about this
		 * node now matches downstream byte for byte and the controller still
		 * answers chip_id 0x0, so the remaining suspect is the transaction
		 * itself against mainline's GENI SPI controller. Dropping the clock is
		 * the standard first test for that. Raise it again once touch works.
		 */
		spi-max-frequency = <1000000>;
		fts,default-fw-name = "st_fts_l1.ftb";
		fts,config-array-size = <1>;

		fts,cfg_0 {
			fts,tp-vendor = <0x38>;
			fts,fw-name = "st_fts_l1.ftb";
			fts,limit-name = "stm_fts_production_limits.csv";
		};
	};
};

