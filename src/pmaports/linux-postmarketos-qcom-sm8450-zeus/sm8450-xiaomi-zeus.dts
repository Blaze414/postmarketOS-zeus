&usb_1_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
	maximum-speed = "high-speed";
	/* Remove USB3 phy */
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
};

&usb_1_dwc3_hs {
	remote-endpoint = <&pmic_glink_hs_in>;
};

&usb_1_hsphy {
	vdda-pll-supply = <&pm8350_l5>;
	vdda18-supply = <&pm8350c_l1>;
	vdda33-supply = <&pm8350_l2>;

	status = "okay";
};

&vamacro {
	//pinctrl-0 = <&dmic01_default>, <&dmic02_default>;
	//pinctrl-names = "default";
	vdd-micb-supply = <&pm8350_s10>;
	qcom,dmic-sample-rate = <600000>;

	status = "okay";
};

&wsamacro {
	status = "disabled";
};

&wsa2macro {
	status = "disabled";
};

&wsa_swr_active {
	status = "disabled";
};

&wsa2_swr_active {
	status = "disabled";
};

/*
 * CPU thermal throttling.
 *
 * sm8450.dtsi describes 17 CPU thermal zones and gives the CPUs #cooling-cells,
 * but wires cooling-maps only on the two GPU zones. The CPU zones therefore have
 * no passive throttling at all: their only passive trips sit at 115C and 125C,
 * which are monitoring thresholds, not throttle points. Under sustained load an
 * 8 Gen 1 would climb straight to a critical trip and emergency-shutdown rather
 * than stepping frequency down.
 *
 * Bind each CPU zone to its cluster's cpufreq cooling device with an 85C passive
 * trip. Clusters: cpu0-3 A510, cpu4-6 A710, cpu7 X2.
 *
 * 85C is deliberately conservative for a first port - it throttles well before
 * the 115C monitoring trips and long before critical. Raise it once the device
 * has run real workloads and the thermal behaviour is known.
 */
&{/thermal-zones} {
		cpu0-thermal {
			polling-delay-passive = <250>;

			trips {
				cpu0_alert: trip-point-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu0_alert>;
					cooling-device =
					<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu1-thermal {
			polling-delay-passive = <250>;

			trips {
				cpu1_alert: trip-point-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu1_alert>;
					cooling-device =
					<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
