From: YusufAlZadid <yusufalzadid@gmail.com>
Subject: [PATCH] ASoC: qcom: sc8280xp: match TDM slot width to the amps

snd_mask_set_format() only adds S32_LE to the backend format mask, so
S16_LE stayed selected and CS35L41 configured 16-bit slots
(ASP_RX_WIDTH = params_width) while the DSP framed 32-bit ones: the amps
read the zero padding of each slot. Drop the hack and frame the TDM bus
at the sample width the codecs actually use.

---
--- a/sound/soc/qcom/sc8280xp.c	2026-09-15 00:30:05
+++ b/sound/soc/qcom/sc8280xp.c	2026-09-15 00:30:05
@@ -133,9 +133,6 @@
 	rate->min = rate->max = 48000;
 	channels->min = 2;
 	channels->max = 2;
-	if (cpu_dai->id >= PRIMARY_TDM_RX_0 && cpu_dai->id <= QUINARY_TDM_TX_7)
-		snd_mask_set_format(hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT),
-				    SNDRV_PCM_FORMAT_S32_LE);
 	switch (cpu_dai->id) {
 	case TX_CODEC_DMA_TX_0:
 	case TX_CODEC_DMA_TX_1:
@@ -210,8 +207,15 @@
 		struct snd_soc_dai *codec_dai;
 		unsigned int slot;
 		int i, ret;
+		/*
+		 * CS35L41 takes its slot width from the sample width
+		 * (ASP_RX_WIDTH = params_width), so the DSP must frame the same
+		 * width or the amps read padding. Stock's 32-bit slots only
+		 * hold because stock plays 24-bit in them on both sides.
+		 */
+		unsigned int width = params_width(params);
 
-		ret = snd_soc_dai_set_tdm_slot(cpu_dai, 0, 0x3, 8, 32);
+		ret = snd_soc_dai_set_tdm_slot(cpu_dai, 0, 0x3, 8, width);
 		if (ret)
 			return ret;
 
@@ -229,7 +233,7 @@
 				return ret;
 		}
 
-		return sc8280xp_snd_mi2s_set_sysclk(rtd, params_rate(params) * 32 * 8);
+		return sc8280xp_snd_mi2s_set_sysclk(rtd, params_rate(params) * width * 8);
 	}
 	default:
 		break;
