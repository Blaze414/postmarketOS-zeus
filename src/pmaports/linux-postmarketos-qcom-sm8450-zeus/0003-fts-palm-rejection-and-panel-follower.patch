diff --git a/drivers/input/touchscreen/fts_spi/fts.c b/drivers/input/touchscreen/fts_spi/fts.c
index aa6dd5dbb..32ba68218 100644
--- a/drivers/input/touchscreen/fts_spi/fts.c
+++ b/drivers/input/touchscreen/fts_spi/fts.c
@@ -129,6 +129,9 @@ extern int power_supply_is_system_supplied(void);
 * Release all the touches in the linux input subsystem
 * @param info pointer to fts_ts_info which contains info about the device and its hw setup
 */
+/* ids whose contacts were rejected as palm/zone; see fts_in_reject_zone() */
+static unsigned long fts_reject_id;
+
 void release_all_touches(struct fts_ts_info *info)
 {
 	unsigned int type = MT_TOOL_FINGER;
@@ -143,6 +146,7 @@ void release_all_touches(struct fts_ts_info *info)
 	input_sync(info->input_dev);
 	info->touch_id = 0;
 	info->temp_touch_id = 0;
+	fts_reject_id = 0;
 	info->width_major = 0;
 	info->width_minor = 0;
 	info->orientation = 0;
@@ -2353,6 +2357,46 @@ static void fts_nop_event_handler(struct fts_ts_info *info,
 * Event handler for enter and motion events (EVT_ID_ENTER_POINT, EVT_ID_MOTION_POINT )
 * report to the linux input system touches with their coordinated and additional informations
 */
+/*
+ * Palm and corner rejection.
+ *
+ * The firmware already classifies a contact as TOUCH_TYPE_PALM, but this driver
+ * falls it through to MT_TOOL_FINGER and reports it like any fingertip. On a
+ * phone with curved glass that is a stream of spurious touches. Downstream never
+ * had to handle it here because Xiaomi does the rejection in its separate
+ * xiaomi_touch layer, together with the fts,touch-{dead,edge,corner}zone-filter
+ * tables - none of which exist on mainline, and none of which this driver even
+ * parses.
+ *
+ * The corner boxes below are the stock fts,touch-cornerzone-filter-ver entries
+ * converted from panel pixels to the super-resolution units this driver reports
+ * in (x_max 14400 for 1440px, y_max 32000 for 3200px, so x10): bottom-left
+ * (0,2799)-(250,3199) and bottom-right (1189,2799)-(1439,3199). That is where a
+ * hand resting on the phone actually lands.
+ *
+ * The stock 60px left/right edge bands are deliberately NOT applied. Downstream
+ * treats those as conditional rather than absolute, and suppressing them outright
+ * would eat legitimate edge swipes. fts,edge-suppress-x exists to try a band
+ * without a rebuild; it defaults to 0, meaning off.
+ */
+#define FTS_CORNER_Y_MIN	27990
+#define FTS_CORNER_X_LEFT	2500
+#define FTS_CORNER_X_RIGHT	11890
+
+static bool fts_in_reject_zone(struct fts_ts_info *info, int x, int y)
+{
+	int edge = info->board->edge_suppress_x;
+
+	if (y >= FTS_CORNER_Y_MIN &&
+	    (x <= FTS_CORNER_X_LEFT || x >= FTS_CORNER_X_RIGHT))
+		return true;
+
+	if (edge > 0 && (x <= edge || x >= info->board->x_max - edge))
+		return true;
+
+	return false;
+}
+
 static void fts_enter_pointer_event_handler(struct fts_ts_info *info,
 					    unsigned char *event)
 {
@@ -2398,6 +2442,32 @@ static void fts_enter_pointer_event_handler(struct fts_ts_info *info,
 		x = info->board->x_max - x;
 	if (info->board->swap_y)
 		y = info->board->y_max - y;
+	/*
+	 * Drop palms and contacts starting in a rejection zone. Motion for an
+	 * already-rejected id is dropped too - this handler doubles as the
+	 * motion handler - and a contact that turns into a palm after being
+	 * reported gets its slot released so it cannot stick down forever.
+	 */
+	if (touchType == TOUCH_TYPE_PALM || fts_in_reject_zone(info, x, y)) {
+		if (!test_bit(touchId, &fts_reject_id)) {
+			__set_bit(touchId, &fts_reject_id);
+			if (test_bit(touchId, &info->touch_id)) {
+				input_mt_slot(info->input_dev, touchId);
+				input_mt_report_slot_state(info->input_dev,
+							   MT_TOOL_FINGER, 0);
+				input_report_abs(info->input_dev,
+						 ABS_MT_TRACKING_ID, -1);
+				__clear_bit(touchId, &info->touch_id);
+				__clear_bit(touchId, &info->temp_touch_id);
+			}
+			logError(1, "%s %s: rejected id=%d type=%d (%d,%d)\n",
+				 tag, __func__, touchId, touchType, x, y);
+		}
+		goto no_report;
+	}
+	if (test_bit(touchId, &fts_reject_id))
+		goto no_report;
+
 	input_mt_slot(info->input_dev, touchId);
 	switch (touchType) {
 	case TOUCH_TYPE_FINGER:
@@ -2479,6 +2549,14 @@ static void fts_leave_pointer_event_handler(struct fts_ts_info *info,
 	touchType = event[1] & 0x0F;
 	touchId = (event[1] & 0xF0) >> 4;
 
+	/* never reported, so there is no slot state to unwind */
+	if (test_bit(touchId, &fts_reject_id)) {
+		__clear_bit(touchId, &fts_reject_id);
+		__clear_bit(touchId, &info->touch_id);
+		__clear_bit(touchId, &info->temp_touch_id);
+		return;
+	}
+
 	input_mt_slot(info->input_dev, touchId);
 	switch (touchType) {
 	case TOUCH_TYPE_FINGER:
@@ -3655,6 +3733,43 @@ static int fts_mode_handler(struct fts_ts_info *info, int force)
 /**
  * Resume work function which perform a system reset, clean all the touches from the linux input system and prepare the ground for enabling the sensing
  */
+/*
+ * Display state.
+ *
+ * resume_bit gates every touch report, and the only things that ever queue
+ * fts_{suspend,resume}_work are a debugfs helper and system PM. Downstream
+ * drives them from Xiaomi's panel notifier, which does not exist on mainline,
+ * so once the display blanked nothing told this driver to come back and touch
+ * simply stopped until the module was reloaded.
+ *
+ * Mainline's equivalent is drm_panel_follower: the panel calls us around its
+ * own prepare/unprepare, and drm_panel_add_follower() finds the panel through
+ * the "panel" phandle on our own node - the same property the stock devicetree
+ * carries on this touchscreen.
+ */
+static int fts_panel_prepared(struct drm_panel_follower *follower)
+{
+	struct fts_ts_info *info =
+		container_of(follower, struct fts_ts_info, panel_follower);
+
+	queue_work(info->event_wq, &info->resume_work);
+	return 0;
+}
+
+static int fts_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	struct fts_ts_info *info =
+		container_of(follower, struct fts_ts_info, panel_follower);
+
+	queue_work(info->event_wq, &info->suspend_work);
+	return 0;
+}
+
+static const struct drm_panel_follower_funcs fts_panel_follower_funcs = {
+	.panel_prepared = fts_panel_prepared,
+	.panel_unpreparing = fts_panel_unpreparing,
+};
+
 static void fts_resume_work(struct work_struct *work)
 {
 	struct fts_ts_info *info;
@@ -4043,6 +4158,28 @@ static int parse_dt(struct device *dev, struct fts_hw_platform_data *bdata)
 	bdata->support_vsync_mode =
 		of_property_read_bool(np, "fts,support-vsync-mode");
 
+	/*
+	 * This fork declares support_super_resolution and branches on it when
+	 * decoding a touch event, but never assigns it - so it was always 0 and
+	 * the low-resolution decode was used, while x-max/y-max in the
+	 * devicetree describe the super-resolution axes (14400 x 32000, ten
+	 * times the 1440x3200 panel). A 12-bit coordinate was therefore being
+	 * reported on an axis userspace believed was ten times larger, which
+	 * squashed every touch into the top-left corner, and the low-res y
+	 * formula takes its low bits from the upper nibble of event[3], which is
+	 * why y jumped around while x looked stable.
+	 */
+	if (of_property_read_u32(np, "fts,support-super-resolution",
+				 &bdata->support_super_resolution))
+		bdata->support_super_resolution = 0;
+	logError(1, "%s super resolution: %u\n", tag,
+		 bdata->support_super_resolution);
+
+	/* 0 = off. See fts_in_reject_zone(). */
+	if (of_property_read_u32(np, "fts,edge-suppress-x",
+				 &bdata->edge_suppress_x))
+		bdata->edge_suppress_x = 0;
+
 	retval = of_property_read_u32(np, "fts,config-array-size",
 				      (u32 *)&bdata->config_array_size);
 
@@ -4878,6 +5015,24 @@ static int fts_probe(struct spi_device *client)
 		goto ProbeErrorExit_6;
 	}
 	info->vsync_fps = 120;
+
+	/*
+	 * Optional: without a "panel" phandle there is nothing to follow, and
+	 * touch still works for as long as the display never blanks.
+	 */
+	if (of_property_present(info->dev->of_node, "panel")) {
+		info->panel_follower.funcs = &fts_panel_follower_funcs;
+		error = devm_drm_panel_add_follower(info->dev,
+						    &info->panel_follower);
+		if (error) {
+			logError(1, "%s cannot follow panel: %d\n", tag, error);
+			goto ProbeErrorExit_6;
+		}
+		logError(1, "%s following panel for display state\n", tag);
+	} else {
+		logError(1, "%s no panel phandle, display state not tracked\n",
+			 tag);
+	}
 #ifdef CONFIG_SECURE_TOUCH
 	logError(1, "%s %s create secure touch file...\n", tag, __func__);
 	error = fts_secure_init(info);
