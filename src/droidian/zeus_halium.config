# Halium/Droidian kconfig requirements for zeus, derived by running
# mer-kernel-check against gki_defconfig + vendor/waipio_GKI.config on
# LineageOS 5.10.256. Every symbol here was an ERROR from that check.

# Core userland expectations Android builds leave out
CONFIG_SYSVIPC=y
CONFIG_FHANDLE=y
CONFIG_VT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_QUOTA_NETLINK_INTERFACE=y

# systemd refuses to run with this on: it forces every usermode helper
# through a single fixed binary.
# CONFIG_STATIC_USERMODEHELPER is not set

# Networking bits Halium expects. These four must be built in, not modules -
# mer-kernel-check rejects =m for them.
CONFIG_DUMMY=y
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_INET_AH=y
CONFIG_INET6_AH=y
CONFIG_INET_IPCOMP=m
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_NF_LOG_IPV4=m
CONFIG_NF_LOG_IPV6=m
CONFIG_L2TP_V3=y
CONFIG_L2TP_IP=m

# PPP - needed for mobile data
CONFIG_PPPOE=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m
CONFIG_PPP_FILTER=y
CONFIG_PPP_MULTILINK=y

# The whole point of this path: the ST FingerTip touchscreen driver, in-tree
# here and talking to Qualcomm's own SPI driver rather than mainline's GENI.
# Note the vendor Kconfig declares "depends on I2C" even though this is the SPI
# variant, so I2C must stay enabled.
CONFIG_I2C=y
# Built as modules, not built in. fts.c calls panel_event_notifier_register(),
# which is provided by the external display-drivers techpack - not in this tree.
# As built-ins they break the vmlinux link; as modules the symbol is resolved at
# load time once the techpack module is present.
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=m
# Provides register_xiaomi_touch_client(), which fts.c also needs.
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# SPI master for the touch controller
CONFIG_SPI=y
CONFIG_SPI_QUP=y
CONFIG_SPI_QCOM_GENI=y
